SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
CONTEXT_DEV_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Track C account/agent settings. Auth uses SUPABASE_URL above by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional separate Track A deployment; unset uses lib/shops/repository directly.
CATALOG_API_ORIGIN=
# Optional override; falls back to NEXT_PUBLIC_SITE_URL above.
APP_ORIGIN=

# Track B: all secrets are SERVER ONLY. Testnet only.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PAYMENTS_FACILITATOR_MODE=hosted
HOSTED_FACILITATOR_URL=https://x402.org/facilitator
# 32-byte hex, no 0x; openssl rand -hex 32. Persist securely; losing it loses access to wallets.
PAYMENTS_ENCRYPTION_KEY=
# Prefer the ID of an encrypted treasury wallet imported into track_b_wallets.
TREASURY_WALLET_ID=
# Optional externally provisioned treasury key instead of treasury wallet ID.
TREASURY_PRIVATE_KEY=
# Only required in local facilitator mode; dedicated Base Sepolia ETH funded key.
FACILITATOR_PRIVATE_KEY=
TESTNET_OFFRAMP_ADDRESS=
PAYMENTS_ALLOWED_ORIGINS=http://localhost:3000
# Explicitly enable the real testnet browser checkout after configuring the server.
PAYMENTS_CHECKOUT_ENABLED=false
# Automatically fund new buyer wallets with 10 testnet AUSD, once per buyer.
PAYMENTS_AUTO_FUND_BUYERS=false
# Browser/Instinct per-purchase cap in cents. Default 25 AUSD; allowed range 1–10000.
# Agent sessions never provision wallets or invoke treasury funding, even when auto-funding is enabled.
PAYMENTS_BROWSER_MAX_ORDER_CENTS=2500
